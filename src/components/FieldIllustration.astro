---
// Apresentação alternativa do campo (plano 3.6): mesma navegação dos hotspots, sem WebGL nem JS.
// Planta esquemática da composição aprovada (ADR 0004); posições em % da ilustração.
import { hotspots, type HotspotId } from '@/data/hotspots';

const pins = {
  scoreboard: { left: 4.9, top: 24, align: 'start' },
  goal: { left: 6.8, top: 41, align: 'start' },
  character: { left: 43.6, top: 59.6, align: 'center' },
  bench: { left: 39.2, top: 81, align: 'center' },
} as const satisfies Record<HotspotId, { left: number; top: number; align: 'start' | 'center' }>;
---

<div class="field-illustration" data-testid="field-illustration" data-illustration>
  <div class="field-illustration__canvas">
    <svg viewBox="0 0 470 225" role="img" aria-labelledby="field-illustration-title">
      <title id="field-illustration-title">
        Planta ilustrada do campo society, com placar, gols, banco, personagem e área de entrada
      </title>
      <rect class="ground" x="12" y="20" width="450" height="200" rx="6"></rect>
      <rect class="pitch" x="30" y="47" width="280" height="126"></rect>
      <g class="lines">
        <line x1="170" y1="47" x2="170" y2="173"></line>
        <circle cx="170" cy="110" r="21"></circle>
        <path d="M30 82 H58 V138 H30 M310 82 H282 V138 H310"></path>
      </g>
      <g class="spots">
        <circle cx="72" cy="110" r="1.5"></circle>
        <circle cx="268" cy="110" r="1.5"></circle>
        <circle cx="170" cy="110" r="1.5"></circle>
      </g>
      <rect class="fence" x="23" y="40" width="294" height="140"></rect>
      <g class="goals">
        <rect x="25" y="92.5" width="7" height="35"></rect>
        <rect x="308" y="92.5" width="7" height="35"></rect>
      </g>
      <g class="floodlights">
        <circle cx="19" cy="34" r="3"></circle>
        <circle cx="321" cy="34" r="3"></circle>
        <circle cx="19" cy="186" r="3"></circle>
        <circle cx="321" cy="186" r="3"></circle>
      </g>
      <rect class="scoreboard" x="18" y="54" width="5" height="28"></rect>
      <rect class="bench" x="170" y="183" width="28" height="12"></rect>
      <circle class="ball" cx="72" cy="110" r="2.5"></circle>
      <circle class="character" cx="205" cy="138" r="4.5"></circle>
      <rect class="path" x="320" y="134.5" width="133" height="21"></rect>
      <g class="buildings">
        <rect x="345" y="36.5" width="28" height="35"></rect>
        <rect x="345" y="82" width="28" height="21"></rect>
        <rect x="345" y="106.5" width="28" height="21"></rect>
      </g>
      <g class="chairs">
        <rect x="327" y="45" width="4" height="4"></rect>
        <rect x="327" y="54" width="4" height="4"></rect>
        <rect x="327" y="63" width="4" height="4"></rect>
        <rect x="327" y="72" width="4" height="4"></rect>
      </g>
      <rect class="soap" x="383.5" y="162.5" width="63" height="49" rx="3"></rect>
      <circle class="trampoline" cx="338" cy="180" r="11"></circle>
    </svg>
    <ul class="field-illustration__pins">
      {hotspots.map(({ id, label, route }) => (
        <li
          style={`--pin-left: ${pins[id].left}%; --pin-top: ${pins[id].top}%`}
          data-align={pins[id].align}
        >
          <a class="button" href={route}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .field-illustration {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-2);
  }
  .field-illustration__canvas {
    position: relative;
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .ground {
    fill: var(--color-field-ground);
  }
  .pitch {
    fill: var(--color-field-turf);
  }
  .lines,
  .fence {
    fill: none;
    stroke: var(--color-field-line);
    stroke-width: 1;
  }
  .fence {
    stroke: var(--color-field-fence);
    stroke-dasharray: 3 2;
  }
  .spots,
  .ball,
  .goals {
    fill: var(--color-field-line);
  }
  .floodlights,
  .scoreboard {
    fill: var(--color-field-fence);
  }
  .bench,
  .path,
  .buildings {
    fill: var(--color-field-wall);
  }
  .bench {
    stroke: var(--color-field-roof);
  }
  .character,
  .chairs {
    fill: var(--color-field-red);
  }
  .soap {
    fill: var(--color-field-blue);
    stroke: var(--color-field-yellow);
    stroke-width: 3;
  }
  .trampoline {
    fill: var(--color-field-blue);
    stroke: var(--color-field-yellow);
  }
  .field-illustration__pins {
    display: grid;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .field-illustration__pins a {
    width: 100%;
    background: var(--color-overlay);
  }
  @media (min-width: 48rem) {
    .field-illustration__canvas {
      display: block;
      aspect-ratio: 470 / 225;
      width: min(100%, calc((var(--size-scene) - var(--space-4)) * 470 / 225));
    }
    .field-illustration__pins {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .field-illustration__pins li {
      position: absolute;
      left: var(--pin-left);
      top: var(--pin-top);
      translate: -50% -100%;
      pointer-events: auto;
    }
    .field-illustration__pins li[data-align='start'] {
      translate: 0 -100%;
    }
    .field-illustration__pins a {
      width: auto;
      white-space: nowrap;
    }
  }
</style>
