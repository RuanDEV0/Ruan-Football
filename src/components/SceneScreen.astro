---
// Tela do cenário (ADR 0006): HTML real que a cena posiciona sobre o objeto do hotspot. O conteúdo
// vem dos mesmos componentes das páginas; o link leva à página completa e “Voltar ao campo” fica na
// própria tela, dentro do cenário (ADR 0007).
import { hotspots, type HotspotId } from '@/data/hotspots';
interface Props {
  id: HotspotId;
  /** Nome do suporte no cenário, exibido acima do título. */
  kind: string;
}
const { id, kind } = Astro.props;
const hotspot = hotspots.find((item) => item.id === id);
if (!hotspot) throw new Error(`Hotspot desconhecido: ${id}`);
---

<article class="scene-screen" data-screen={id} aria-labelledby={`screen-${id}`} hidden>
  <div class="scene-screen__inner">
    <p class="scene-screen__kind">{kind}</p>
    <h2 id={`screen-${id}`} tabindex="-1">
      {hotspot.label}
    </h2>
    <div class="scene-screen__body">
      <slot />
    </div>
    <div class="scene-screen__actions">
      <a class="button scene-screen__link" href={hotspot.route}>
        Ir para {hotspot.label}
      </a>
      <button type="button" class="scene-screen__back" data-overview>
        Voltar ao campo
      </button>
    </div>
  </div>
</article>
